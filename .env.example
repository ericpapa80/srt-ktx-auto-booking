# Copy this file to ~/.config/srt-ktx-auto-booking/.env and fill in your own credentials.
# Never commit the real env file.

# SRT login
KSKILL_SRT_ID=your_srt_id_here
KSKILL_SRT_PASSWORD=your_srt_password_here

# KTX login
KSKILL_KTX_ID=your_ktx_id_here
KSKILL_KTX_PASSWORD=your_ktx_password_here

# Optional: only needed when using --notify telegram for the SRT watcher.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: OpenClaw Telegram notification. This avoids managing a separate Telegram bot token.
# Example direct chat target: telegram:<CHAT_ID>
OPENCLAW_NOTIFY_TARGET=
OPENCLAW_NOTIFY_CHANNEL=telegram
OPENCLAW_NOTIFY_ACCOUNT=default
OPENCLAW_BIN=openclaw
